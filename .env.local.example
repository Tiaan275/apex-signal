# ══════════════════════════════════════════════════════════════════
#  Apex Signal — Environment Variables Reference
#  1. Copy this file:  cp .env.local.example .env.local
#  2. Fill in every value marked ← REQUIRED before running npm dev
#  3. NEVER commit .env.local to git (it is in .gitignore)
# ══════════════════════════════════════════════════════════════════

# ─── App ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000          # ← change to prod URL on deploy

# ─── Supabase ────────────────────────────────────────────────────
# Found at: Supabase → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co  # ← REQUIRED
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...               # ← REQUIRED (safe to expose)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                   # ← REQUIRED · SERVER ONLY · never prefix NEXT_PUBLIC_

# ─── Admin ───────────────────────────────────────────────────────
# Protects /admin routes. Generate with: openssl rand -hex 32
ADMIN_SECRET=                                      # ← REQUIRED · SERVER ONLY

# ─── MailerLite ──────────────────────────────────────────────────
# Found at: MailerLite → Integrations → Developer API → API tokens
MAILERLITE_API_KEY=                                # ← REQUIRED · SERVER ONLY
MAILERLITE_GROUP_ID=183309795863823756             # ← pre-filled (Pre-Launch Waitlist group)

# ─── OpenAI ──────────────────────────────────────────────────────
# Used by signal generation (Phase 3). Not required for Phase 1.
OPENAI_API_KEY=sk-...

# ─── Alpha Vantage ───────────────────────────────────────────────
# Used for market data (Phase 3). Free key: alphavantage.co/support
ALPHA_VANTAGE_API_KEY=

# ─── Stripe ──────────────────────────────────────────────────────
# Found at: dashboard.stripe.com → Developers → API keys
# Publishable key is safe to expose (NEXT_PUBLIC_). Secret is not.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...     # ← needed for Phase 2 checkout
STRIPE_SECRET_KEY=sk_test_...                      # ← SERVER ONLY
STRIPE_WEBHOOK_SECRET=whsec_...                    # ← SERVER ONLY (from Stripe CLI / dashboard)

# ─── n8n (Railway) ───────────────────────────────────────────────
N8N_WEBHOOK_BASE_URL=https://n8n-production-46fe.up.railway.app
N8N_API_KEY=                                       # ← n8n Settings → API → Personal API key
